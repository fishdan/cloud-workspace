aws_region  = "us-east-1"
environment = "dev"
cost_center = "engineering"

vpc_id = "vpc-0123456789abcdef0"

private_subnet_ids = [
  "subnet-0123456789abcdef0",
  "subnet-0fedcba9876543210",
]

allowed_ssh_cidr_blocks = [
  "10.0.0.0/8",
]

tags = {
  Owner = "platform"
}

engineers = {
  alice = {
    username          = "alice"
    ssh_public_key    = "ssh-ed25519 AAAA_REPLACE_ME alice@example.com"
    instance_type     = "t3.large"
    workspace_size_gb = 100
    enabled           = true
    subnet_index      = 0
    tags = {
      Team = "app"
    }
  }
}
